# --- Arathon dataset: NOT redistributable before ARA's public release -------
# Raw measurements plus anything derived that carries measurement values or
# coordinates. Keep these out until the dataset is officially published.
extracted/
COTS_Dataset.zip
sionna-approach/bundle/data/
*.zip
*.npz
# per-chunk crash-recovery saves from predict_surface.py
*.part[0-9][0-9][0-9].npy
# figure kept: private repo, needed by the approach README

# --- Regenerable build artifacts; several exceed GitHub's 100 MB limit ------
# gitignore has no trailing comments, so sizes/sources are noted above each line.
# 127 MB, re-download from Geofabrik
sionna-approach/scene/iowa-latest.osm.pbf
# 51 MB, regenerate with clip_osm.py
sionna-approach/scene/ames.osm
# 148 MB, regenerate with build_terrain_3dep.py
sionna-approach/scene/mitsuba/meshes/Terrain3DEP.ply
# skadi tiles, auto-cached on first import
sionna-approach/scene/blosm_data/
# 40 MB and 375 MB, rebuilt by import_scene.py / make_blend_3dep.py
sionna-approach/scene/*.blend
sionna-approach/scene/*.blend1
sionna-approach/scene/preview_*.png

__pycache__/
*.pyc
.DS_Store
# 16 MB each, regenerate with make_terrain_variants.py from dem_3dep.tif
sionna-approach/scene/mitsuba/meshes/Terrain3DEP_s3_*.ply

# --- terrain-approach ------------------------------------------------------
# NEVER COMMIT. Derived frames carry measurement values and coordinates; the
# USGS tiles are 450 MB and 416 MB. All of it is regenerated by run_all.py.
terrain-approach/data/
terrain-approach/reports/eda.json
terrain-approach/reports/analysis.json
terrain-approach/reports/percentiles.json

# The rendered tools and the deck ARE committed. They embed the 7,144 measurement
# positions, so this is a deliberate exception to the dataset policy above, taken
# because the repo is private and these are the deliverables.

# --- shared platform ------------------------------------------------------
# Coverage bundles carry the demand grid and candidate coordinates, so they fall
# under the dataset policy above. They are regenerable: common/bundle.py.
bundles/
# 61 MB, re-download from minedbuildings.z5.web.core.windows.net (see RUNNING.md)
sionna-approach/scene/iowa_ms.zip
# regenerate with build_ms_buildings.py <height>
sionna-approach/scene/mitsuba/meshes/ms_buildings_h*.ply

# ~30 MB of cached simulation output: path-gain matrices, service surfaces, per-run
# dumps. Derived from the measurement dataset, so excluded on licence grounds as well
# as size. sionna-approach/simcache/README.md documents how to regenerate every file.
sionna-approach/simcache/

# A working copy of scene/ made to hand over the Microsoft building meshes. Contains
# 375 MB .blend files and the 127 MB Geofabrik PBF; the scene/ rules above do not match
# a directory with a space in the name.
sionna-approach/scene copy/

# Coverage bundles from common/bundle.py, same policy as bundles/ above: they carry the
# demand grid and candidate coordinates. Regenerable by run_pipeline.py.
reports/bundle_*.json

# --- pinn-approach ---------------------------------------------------------
# Torch checkpoints and cached prediction arrays carry measurement coordinates.
pinn-approach/data/
pinn-approach/**/*.pt
