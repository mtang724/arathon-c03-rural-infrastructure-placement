# Everything in this project is committed, including derived data, coverage
# bundles and the measurement-bearing reports. The repository is private.
#
# What remains excluded is excluded for ONE reason only: GitHub rejects any
# single file over 100 MB, so pushing these would fail the push rather than
# store them. Each line records the size and how to regenerate it. If you want
# them tracked, `git lfs track` the pattern and delete the line.

# 429 MB and 397 MB. USGS 3DEP 1/3 arc-second, public domain, re-downloadable
# from The National Map for bbox 41.9225,-93.8921 -> 42.0492,-93.6588.
# src/propagation.py mosaics them into data/dem10.npz, which IS committed.
terrain-approach/data/USGS_13_*.tif

# 127 MB. Geofabrik extract; sionna-approach/scene/clip_osm.py cuts ames.osm
# from it, and that clipped file is committed.
sionna-approach/scene/iowa-latest.osm.pbf

# 148 MB, rebuilt by build_terrain_3dep.py.
sionna-approach/scene/mitsuba/meshes/Terrain3DEP.ply

# 40 MB and 375 MB, rebuilt by import_scene.py / make_blend_3dep.py.
sionna-approach/scene/*.blend
sionna-approach/scene/*.blend1

# Compiled bytecode: machine-specific, regenerated on every run, and pure churn
# in a diff. This is the one exclusion that is a judgement rather than a limit.
__pycache__/
*.pyc
.DS_Store
